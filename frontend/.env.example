# Both are optional and normally left unset.
#
# The app calls the API with relative URLs and derives the WebSocket URL from
# window.location, so it works same-origin behind whatever is serving it: Vite's
# /api proxy in dev, nginx's in the container image. Nothing host-specific ends up
# inlined in the bundle.
#
# Set these only when the API genuinely lives on another origin (a separate API
# domain, say). Vite inlines VITE_* at build time, so a change needs a rebuild.
#
# VITE_API_BASE_URL=https://api.example.com
# VITE_WS_BASE_URL=wss://api.example.com
