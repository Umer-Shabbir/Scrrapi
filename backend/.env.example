# App DB. Port 5434 is what docker-compose publishes app_db on -- the two Postgres
# instances can't both take 5432 on the host. Compose overrides these with the
# in-network hostnames when the backend runs as a container.
APP_DB_URL=postgresql+psycopg://leadgen:leadgen@localhost:5434/leadgen_app

# Geo reference DB (GeoNames-seeded), published on 5433.
GEO_DB_URL=postgresql+psycopg://leadgen:leadgen@localhost:5433/leadgen_geo

# Redis (Celery broker + result backend)
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Lock an account after this many consecutive failed logins, for this long.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
TOTP_PENDING_TOKEN_MINUTES=5

# Logging: json for shipped logs, text for readable local output
LOG_LEVEL=INFO
LOG_FORMAT=json

# Scraping
DEFAULT_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36"
SCRAPE_MIN_DELAY_MS=500
SCRAPE_MAX_DELAY_MS=2000

# 429 handling: cooldown per host, doubles per consecutive block, capped at max
RATE_LIMIT_BASE_COOLDOWN_S=30
RATE_LIMIT_MAX_COOLDOWN_S=900

# Celery retry/backoff
TASK_RETRY_BACKOFF_BASE_S=10
TASK_RETRY_BACKOFF_MAX_S=900
TASK_RETRY_JITTER=0.25
TASK_MAX_RETRIES_FEED=3
TASK_MAX_RETRIES_PLACE=2
TASK_MAX_RETRIES_EXPORT=2
TASK_SOFT_TIME_LIMIT_S=900
TASK_TIME_LIMIT_S=1200

# Proxy pool: single | list | free
PROXY_MODE=single
PROXY_SINGLE_URL=
PROXY_LIST_PATH=
PROXY_FREE_LIST_URL=https://api.proxyscrape.com/v2/?request=getproxies&protocol=http&timeout=10000&country=all&ssl=all&anonymity=all
PROXY_FREE_LIST_TTL_S=600

# Job sizing. One search runs per ZIP, so "every ZIP in Texas" x 3 keywords is
# ~7800 browser sessions -- both caps exist so that number is refused up front.
# MAX_JOB_TARGETS bounds keywords x locations on a single job; GEO_ZIP_PAGE_LIMIT
# bounds how many postal codes /api/geo/zips will hand the picker at once.
MAX_JOB_TARGETS=2000
GEO_ZIP_PAGE_LIMIT=2000

# Scrape concurrency: how many areas are scraped at once. The live value is a
# runtime setting in the app DB, edited from the Settings page -- this is only
# the value used before anything has been saved there. MAX_CONCURRENT_TARGETS is
# the ceiling that page (and PATCH /api/settings) will accept -- it's also what
# the worker's own pool is fixed at (scripts/dev.mjs, docker-compose.yml), so the
# Settings page slider is the only concurrency control there is; no worker env
# var or restart is needed to change effective throughput.
DEFAULT_CONCURRENT_TARGETS=2
MAX_CONCURRENT_TARGETS=64
# How long a dispatched area may wait to start before the dispatcher assumes its
# task is gone and re-queues it, freeing the slot. Generous on purpose: a busy
# queue means a legitimate wait, and re-queuing early is churn, not corruption.
TARGET_DISPATCH_STALE_S=3600

# Deep site crawl: when a result has a website, walk it for the emails, phone
# numbers and social profiles that aren't on the Maps listing. The first two are
# the values used before anything is saved on the Settings page, which is where
# the live ones are edited (workers read them per place, no redeploy needed).
DEEP_CRAWL_ENABLED=false
DEEP_CRAWL_MAX_PAGES=25
# Ceiling the Settings page and PATCH /api/settings will accept for the above.
MAX_DEEP_CRAWL_PAGES=200
# What one crawl may cost. It runs once per scraped place, so a 2000-place job
# pays all of this 2000 times -- these are the reason a slow site can't park a
# worker slot for the afternoon.
DEEP_CRAWL_MAX_DEPTH=3
DEEP_CRAWL_TIMEOUT_S=45
DEEP_CRAWL_REQUEST_TIMEOUT_S=10
DEEP_CRAWL_CONCURRENCY=4
DEEP_CRAWL_MAX_PAGE_BYTES=2000000
# The sitemap is what finds the contact page on a site whose menu is rendered in
# JavaScript and therefore has no crawlable link to it.
DEEP_CRAWL_USE_SITEMAP=true
DEEP_CRAWL_RESPECT_ROBOTS=true

# Seeded worldwide the geo DB holds ~1.1M cities, so the country/region/city
# pickers search server-side; this caps how many matches come back per keystroke.
GEO_PAGE_LIMIT=200

# Google Sheets export format. Service-account creds only -- path to the
# downloaded JSON key file, and the address the generated sheet is shared with
# (the service account has no Drive UI of its own to find it otherwise).
# Unset means "sheets" exports fail loudly instead of faking a result.
GOOGLE_SHEETS_CREDENTIALS_PATH=
GOOGLE_SHEETS_SHARE_WITH=

# App
ENV=development
CORS_ORIGINS=["http://localhost:5173"]
